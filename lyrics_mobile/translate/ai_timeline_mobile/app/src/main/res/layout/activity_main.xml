<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen_light"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_menu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_secondary_button"
                android:minWidth="0dp"
                android:text="≡"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="오늘의 시간 손실"
                    android:textColor="#191F28"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="설정 필요"
                    android:textColor="#6B7684"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_live_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘 삭제된 시간을 계산하려면 권한이 필요합니다."
                android:textColor="#191F28"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_live_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="앱 기록이 아니라 내 시간이 어디로 새는지 먼저 보여줍니다."
                android:textColor="#6B7684"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_range_day"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="하루"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_range_week"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="일주일"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="13sp" />

            <Button
                android:id="@+id/button_range_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="한달"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="13sp" />

            <Button
                android:id="@+id/button_range_year"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="1년"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layout_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp" />
        </ScrollView>
    </LinearLayout>

    <ScrollView
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="설정"
                android:textColor="#191F28"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="로컬 기록은 로그인 없이 저장됩니다."
                android:textColor="#6B7684"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_panel_soft"
                android:padding="14dp"
                android:textColor="#4E5968"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_accessibility_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_soft"
                android:padding="14dp"
                android:text="권한 상태를 확인합니다."
                android:textColor="#6B7684"
                android:textSize="13sp" />

            <Button
                android:id="@+id/button_permission_setup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:text="권한 설정"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_ai_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="분석 설정"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_google"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="계정"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_refresh"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="오늘/데이터 관리"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_ai_summary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary_button"
                android:text="오늘 돌아보기 만들기"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="모든 기록 삭제"
                android:textAllCaps="false"
                android:textColor="#E05F5F"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
