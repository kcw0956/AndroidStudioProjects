<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini API 설정"
            android:textColor="#191F28"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="API 키는 이 기기에만 저장됩니다. 서버에는 화면 원본이나 OCR 원문이 아니라 정제된 타임라인 이벤트만 보내는 구조로 사용합니다."
            android:textColor="#6B7684"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel_soft"
            android:hint="Gemini API Key"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="#191F28"
            android:textColorHint="#8B95A1" />

        <EditText
            android:id="@+id/input_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel_soft"
            android:hint="모델 ID 예: gemini-3-flash 또는 gemini-flash-latest"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#191F28"
            android:textColorHint="#8B95A1" />

        <TextView
            android:id="@+id/text_settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#6B7684"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_test_api"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secondary_button"
            android:text="API 키 / 모델 테스트"
            android:textAllCaps="false"
            android:textColor="#191F28"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_list_models"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:text="사용 가능한 모델 목록 보기"
            android:textAllCaps="false"
            android:textColor="#191F28"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_save_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="저장"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_close_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="닫기"
                android:textAllCaps="false"
                android:textColor="#191F28"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
